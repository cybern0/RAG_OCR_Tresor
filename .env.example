# Copier en .env (jamais versionné) puis adapter.

# Connexion Postgres (psycopg 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Ollama : génération et embeddings (EMBEDDING_DIM doit correspondre à vector(768) de database/02)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
EMBEDDING_DIM=768

# Serveur OCR (port 8829) et langue de l'OCR
# La sonde de santé du backend n'exige pas /health : toute réponse du host (404 comprise) suffit,
# un server.py personnel sans route /health reste « opérationnel » dès que POST /ocr répond.
OCR_URL=http://localhost:8829
OCR_LANGUAGE=fr

# Fichiers déposés (par défaut Backend/storage/uploads) et taille maximale.
# Stockage à plat : tous les fichiers dans uploads/ sous un nom généré — aucun répertoire par division
# ni par dossier (l'accès est contrôlé par l'application, voir docs/refonte_classes.md).
# UPLOAD_DIR=
MAX_UPLOAD_MB=50

# Conversion Office/OpenDocument -> PDF (aperçu et indexation) : délai calculé d'après la taille du fichier déposé
# = base + secondes par Mo (arrondi au Mo supérieur), plafonné. Ex. : 2 Mo -> 90 s ; 50 Mo -> 810 s.
# CONVERSION_TIMEOUT_BASE_S=60
# CONVERSION_TIMEOUT_PAR_MO_S=15
# CONVERSION_TIMEOUT_MAX_S=1800
# Windows + Word : imprimante imposée à Word pendant la conversion si l'export se bloque (imprimante réseau hors ligne) :
# CONVERSION_WORD_IMPRIMANTE=Microsoft Print to PDF
# Windows + documents Word (.doc/.docx/.rtf/.odt), quand Office ET LibreOffice sont installés sur le serveur.
# L'export PDF de Word piloté par COM peut se bloquer sur un serveur, pour tout document (diagnostic :
# Backend/scripts/diagnostic_conversion.py) ; « auto » limite la perte de temps et bascule sur LibreOffice :
#   auto         Word d'abord avec le délai court ci-dessous, puis LibreOffice avec le délai complet (défaut)
#   libreoffice  LibreOffice directement, Word jamais (à choisir si Word reste bloqué même hors automatisation)
#   office       Word seul, délai complet (comportement d'avant ; si Word se bloque, la conversion échoue)
# CONVERSION_MOTEUR_WORD=auto
# Délai court (secondes) accordé à Word en « auto » avant la bascule sur LibreOffice : un blocage sous COM se voit
# dès les premières secondes ; sans LibreOffice installé, Word garde le délai complet et ce réglage reste sans effet.
# CONVERSION_WORD_DELAI_OFFICE_S=35


# Recherche : nombre de passages renvoyés au LLM, calculé entre ces bornes d'après la taille des fichiers (top-k dynamique),
# et taille maximale du contexte (caractères) pour tenir dans la fenêtre du modèle
# RETRIEVAL_K_MIN=3
# RETRIEVAL_K_MAX=8
# CONTEXT_MAX_CHARS=9000

# OBLIGATOIRE, 32 caractères minimum. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Durée de session (minutes) et origines autorisées par CORS (séparées par des virgules)
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Authentification : gérée par l'application — comptes créés par le super administrateur ou au CLI
# (`python -m app.cli creer-admin`), mots de passe hachés (scrypt) dans la base. Aucun compte du système
# d'exploitation, aucune intégration PAM ni annuaire (décision : docs/refonte_classes.md).

# Interface web : préfixe de l'API et dossier du build du frontend (servi par l'API s'il existe)
# API_PREFIX=/api
# FRONTEND_DIST=../frontend/dist

# Copier en .env (jamais versionné) puis adapter.

# Connexion Postgres (psycopg 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Ollama : génération et embeddings (EMBEDDING_DIM doit correspondre à vector(768) de database/02)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
EMBEDDING_DIM=768

# Serveur OCR (port 8829) et langue de l'OCR
OCR_URL=http://localhost:8829
OCR_LANGUAGE=fr

# Fichiers déposés (par défaut Backend/storage/uploads) et taille maximale
# UPLOAD_DIR=
MAX_UPLOAD_MB=50

# Recherche : nombre de passages renvoyés au LLM, calculé entre ces bornes d'après la taille des fichiers (top-k dynamique),
# et taille maximale du contexte (caractères) pour tenir dans la fenêtre du modèle
# RETRIEVAL_K_MIN=3
# RETRIEVAL_K_MAX=8
# CONTEXT_MAX_CHARS=9000

# OBLIGATOIRE, 32 caractères minimum. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Durée de session (minutes) et origines autorisées par CORS (séparées par des virgules)
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Interface web : préfixe de l'API et dossier du build du frontend (servi par l'API s'il existe)
# API_PREFIX=/api
# FRONTEND_DIST=../frontend/dist

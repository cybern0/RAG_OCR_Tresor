# Variables prévues (à copier en .env, qui ne doit jamais être versionné) :
# DATABASE_URL : connexion Postgres
# OLLAMA_URL : adresse d'Ollama (http://localhost:11434)
# LLM_MODEL : modèle de génération
# EMBEDDING_MODEL : modèle d'embeddings
# OCR_URL : adresse du serveur OCR (port 8829)
# UPLOAD_DIR : dossier des fichiers déposés
# SECRET_KEY : secret de session
